{
  "manifest_version": 3,
  "name": "ReadInsight",
  "description": "Practice translation from real web reading and save weak points to ReadInsight.",
  "version": "0.1.0",
  "action": {
    "default_title": "Open ReadInsight"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://readinsight.bamamei.online/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "permissions": [
    "activeTab",
    "contextMenus",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  }
}
